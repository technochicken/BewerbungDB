# Copy this file to .env and fill in your values.

# --- App ---
# A random secret used to sign session cookies.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-to-a-long-random-string

# Public base URL of your deployment (no trailing slash).
# Used for OAuth metadata and Telegram alert links.
APP_BASE_URL=http://localhost:8000

# --- Optional: override defaults ---
# HOST=0.0.0.0
# PORT=8000
# POLL_INTERVAL=3600        # Job search polling interval in seconds
# URL_CHECK_INTERVAL=86400  # Job URL liveness check interval in seconds

# --- Configured via the web UI (stored in the database) ---
# The following are set through Settings in the app, not here:
#   - Login password
#   - Claude API key  (for AI-assisted job parsing)
#   - Telegram bot token + chat ID  (for status-change alerts)
